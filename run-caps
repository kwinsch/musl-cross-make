#!/bin/sh
# run-caps — verify the build-time-gated capabilities a produced toolchain must
# provide for hardened, optimized production builds. Companion to run-tests:
# run-tests answers "does each language compile/link/run and stay static?";
# run-caps answers "are the toolchain features we rely on actually baked in?".
#
# Motivation: some capabilities (PIE, SSP, CET, LTO, OpenMP, wide atomics,
# graphite/isl, zstd debug+LTO compression, quadmath, gcov/PGO, sanitizers) are
# decided when the *toolchain* is built, not when an app is compiled. A missing
# one fails silently until an app finally asks for it. This gate probes each by
# compiling+linking a minimal case -static and asserting the result — so a
# capability regression is caught here, at publish time, not under deadline.
# Where "baked in" is only provable by behaviour, the probe also *runs* the
# case when it can: fortify-runtime and ssp-runtime assert the overflow is
# actually stopped, asan-runtime asserts a heap overflow is reported, pgo
# round-trips a real profile. Those runtime probes SKIP under --compile-only.
#
# Each probe is compile+link + a static-cleanliness / property check; it runs
# the binary when it can (native or matching arch) but never *needs* to, so a
# foreign target with no qemu is still fully gated. Exits non-zero on any FAIL.
#
# Usage: ./run-caps [--toolchain DIR] [--triple TRIPLE] [--native]
#                   [--compile-only] [-h|--help]
set -u

cd "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

toolchain=output; triple=; native=0; compile_only=0
while [ $# -gt 0 ]; do
	case $1 in
		--toolchain) toolchain=$2; shift ;;
		--triple)    triple=$2; shift ;;
		--native)    native=1 ;;
		--compile-only) compile_only=1 ;;
		-h|--help)   sed -n '2,18p' "$0" | sed 's/^#\{0,1\} \{0,1\}//'; exit 0 ;;
		*) echo "run-caps: unknown arg: $1" >&2; exit 2 ;;
	esac
	shift
done

host_arch=$(uname -m)
if [ "$native" -eq 1 ]; then
	pfx=; triple='(native)'; target_arch=$host_arch
	RE=$(command -v readelf||true); NM=$(command -v nm||true)
else
	[ -d "$toolchain/bin" ] || { echo "run-caps: no $toolchain/bin — build+install first, or --native" >&2; exit 2; }
	if [ -z "$triple" ]; then
		# Default to the configured target (config.mak) — a multi-toolchain
		# output/ must NOT silently pick the alphabetically-first driver.
		[ -f config.mak ] && triple=$(awk -F= '/^[[:space:]]*TARGET[[:space:]]*=/{gsub(/[[:space:]]/,"",$2);print $2}' config.mak | tail -n1)
		[ -x "$toolchain/bin/$triple-gcc" ] || triple=
		if [ -z "$triple" ]; then
			set -- "$toolchain"/bin/*-gcc
			[ -x "$1" ] || { echo "run-caps: no toolchain in $toolchain/bin; build+install or pass --triple" >&2; exit 2; }
			if [ "$#" -gt 1 ]; then
				echo "run-caps: $# toolchains in $toolchain/bin — pass --triple. Available:" >&2
				for g; do b=$(basename "$g"); echo "  ${b%-gcc}" >&2; done
				exit 2
			fi
			triple=$(basename "$1"); triple=${triple%-gcc}
		fi
	fi
	# absolute — probes cd into the work dir (coverage/pgo write .gcda there)
	toolchain=$(CDPATH= cd -- "$toolchain" && pwd)
	pfx="$toolchain/bin/$triple-"; target_arch=${triple%%-*}
	RE="${pfx}readelf"; NM="${pfx}nm"
fi
GCC="${pfx}gcc"; GXX="${pfx}g++"; GCCAR="${pfx}gcc-ar"
GFC="${pfx}gfortran"; GCOV="${pfx}gcov"; STRINGS="${pfx}strings"

runner=
if [ "$compile_only" -eq 0 ]; then
	if [ "$native" -eq 1 ] || [ "$target_arch" = "$host_arch" ]; then runner=direct
	else q="qemu-$target_arch"; command -v "$q" >/dev/null 2>&1 && runner=$q || compile_only=1; fi
fi

W=$(mktemp -d) || exit 1
trap 'rm -rf "$W"' EXIT INT TERM
pass=0; fail=0; skip=0
ok()   { printf '  PASS  %-14s %s\n' "$1" "$2"; pass=$((pass+1)); }
bad()  { printf '  FAIL  %-14s %s\n' "$1" "$2"; fail=$((fail+1)); }
sk()   { printf '  SKIP  %-14s %s\n' "$1" "$2"; skip=$((skip+1)); }
clean(){ [ -z "$("$RE" -l "$1" 2>/dev/null|grep INTERP)" ] && [ -z "$("$RE" -d "$1" 2>/dev/null|grep NEEDED)" ]; }
etype(){ "$RE" -h "$1" 2>/dev/null|sed -n 's/^[[:space:]]*Type:[[:space:]]*\([A-Za-z]*\).*/\1/p'; }
run()  { [ -z "$runner" ] && { echo '(not-run)'; return; }; if [ "$runner" = direct ]; then "$1" 2>/dev/null; else "$runner" "$1" 2>/dev/null; fi; }

echo "== capability gate · triple=$triple · toolchain=$toolchain · run=${runner:-compile-only} =="

# --- static-pie: fully static + position-independent ---
printf 'int main(void){return 0;}\n' > "$W/m.c"
if "$GCC" -static-pie -fPIE -O2 "$W/m.c" -o "$W/spie" 2>"$W/e"; then
	[ "$(etype "$W/spie")" = DYN ] && clean "$W/spie" && ok static-pie "ET_DYN, no interp/NEEDED" \
		|| bad static-pie "type=$(etype "$W/spie") clean=$(clean "$W/spie" && echo y || echo n)"
else bad static-pie "$(head -1 "$W/e")"; fi

# --- ssp-default: -fstack-protector-strong is the compiler default ---
# the asm barrier forces b[] to be a real addressable stack object, else -O2
# elides it and SSP (correctly) emits no canary — a false negative.
printf 'int main(void){char b[64];__asm__ volatile("":: "r"(b):"memory");return 0;}\n' > "$W/ssp.c"
if "$GCC" -O2 -static "$W/ssp.c" -o "$W/ssp" 2>"$W/e"; then
	if "$NM" "$W/ssp" 2>/dev/null | grep -q __stack_chk_fail; then ok ssp-default "canary present with no -fstack-protector flag"
	else bad ssp-default "no __stack_chk_fail ref — --enable-default-ssp not active"; fi
else bad ssp-default "$(head -1 "$W/e")"; fi

# --- ssp-strong: explicit SSP links -static (libssp + libssp_nonshared) ---
if "$GCC" -O2 -fstack-protector-strong -static "$W/ssp.c" -o "$W/sspx" 2>"$W/e"; then
	clean "$W/sspx" && ok ssp-strong "links -static, no shared deps" || bad ssp-strong "not static-clean"
else bad ssp-strong "$(head -1 "$W/e")"; fi

# --- ssp-runtime: an overflow past the buffer must terminate the process ---
# Can't distinguish a canary abort from a raw smashed-return crash (musl's
# __stack_chk_fail is a silent a_crash); the assertion is "the overflow does
# not go unnoticed" — a clean exit 0 after a 64-byte write into char[16] means
# silent corruption and fails.
printf '#include <string.h>\nvolatile size_t n=64;\nint main(void){char b[16];memset(b,65,n);__asm__ volatile(""::"r"(b):"memory");return 0;}\n' > "$W/sspr.c"
if ! "$GCC" -O2 -static "$W/sspr.c" -o "$W/sspr" 2>"$W/e"; then bad ssp-runtime "$(head -1 "$W/e")"
elif [ -z "$runner" ]; then sk ssp-runtime "compile-only (probe must run)"
else
	r=$(run "$W/sspr"); rc=$?
	[ "$rc" -ne 0 ] && ok ssp-runtime "stack smash terminates (rc=$rc)" \
		|| bad ssp-runtime "survived a 64-byte overflow of char[16] — silent corruption"
fi

# --- fortify: _FORTIFY_SOURCE resolves fortify-headers (bare musl ignores it) ---
# the marker is defined only when fortify-headers' string.h is on the include
# path AND _FORTIFY_SOURCE>0 with -O — i.e. our patch+install actually wired it.
printf '#include <string.h>\n#if !defined(_FORTIFY_HEADERS_H)\n#error fortify-headers inactive\n#endif\nint main(void){return 0;}\n' > "$W/fort.c"
if "$GCC" -O2 -D_FORTIFY_SOURCE=2 -static "$W/fort.c" -o "$W/fort" 2>"$W/e"; then
	ok fortify "_FORTIFY_SOURCE resolves fortify-headers wrappers"
else bad fortify "fortify-headers not on include path — _FORTIFY_SOURCE is a no-op"; fi

# --- fortify-runtime: the fortify check must actually fire, not just resolve ---
# Global char[8] dst + runtime length: __bos(dst,0)=8 is compile-time known,
# n=32 comes from a volatile, so the wrapper's (n > bos) branch traps (SIGILL).
# Without fortify the same program is a harmless .bss overspill exiting 0 —
# a clean discriminator (unlike a stack buffer, where SSP would also abort).
printf '#include <string.h>\nstatic char dst[8];static char src[64];volatile size_t n=32;\nint main(void){memcpy(dst,src,n);return 0;}\n' > "$W/fr.c"
if ! "$GCC" -O2 -D_FORTIFY_SOURCE=2 -static "$W/fr.c" -o "$W/fr" 2>"$W/e"; then bad fortify-runtime "$(head -1 "$W/e")"
elif [ -z "$runner" ]; then sk fortify-runtime "compile-only (trap must run)"
else
	r=$(run "$W/fr"); rc=$?
	[ "$rc" -ne 0 ] && ok fortify-runtime "oversized memcpy trapped (rc=$rc)" \
		|| bad fortify-runtime "overflow ran to completion — fortify wrappers inert"
fi

# --- limits-wrap: gcc's own limits.h must include_next musl ---
# all-gcc writes a standalone ISO-C limits.h (no SSIZE_MAX/PATH_MAX,
# MB_LEN_MAX=1) because the sysroot is still empty. Litecross rebuilds
# the official wrapper after musl headers exist. Default compiles hide
# a missing wrap (musl INCLUDE_DEFAULTS puts libc first); force the
# xgcc -B order so a standalone file fails this probe.
if [ "$native" -eq 1 ]; then
	sk limits-wrap "native host gcc — not a litecross artifact"
else
	gccinc=$("$GCC" -print-file-name=include)
	sysinc="$toolchain/$triple/include"
	printf '#include <limits.h>\n#ifndef SSIZE_MAX\n#error no SSIZE_MAX\n#endif\n#ifndef PATH_MAX\n#error no PATH_MAX\n#endif\n#if MB_LEN_MAX < 4\n#error MB_LEN_MAX < 4\n#endif\nint main(void){return 0;}\n' > "$W/lim.c"
	if "$GCC" -nostdinc -isystem "$gccinc" -isystem "$sysinc" -O2 -static "$W/lim.c" -o "$W/lim" 2>"$W/e"; then
		ok limits-wrap "gcc limits.h include_next's musl (SSIZE_MAX/PATH_MAX/MB_LEN_MAX>=4)"
	else bad limits-wrap "$(head -1 "$W/e")"; fi
fi

# --- cet: deliberately NOT pursued on musl (matches Alpine --disable-cet) ---
# musl's crt/libc.a carry no IBT/SHSTK GNU-property, so it is AND'd away on
# every static link and can't be forced on safely (musl code lacks endbr).
# Delivering CET would require building musl itself with -fcf-protection.
sk cet "off by design on musl (crt/libc unmarked; Alpine --disable-cet)"

# --- lto: cross-TU -flto, -static ---
printf 'int add(int,int);int main(void){return add(19,23)==42?0:1;}\n' > "$W/a.c"
printf 'int add(int a,int b){return a+b;}\n' > "$W/b.c"
if "$GCC" -O2 -flto "$W/a.c" "$W/b.c" -static -o "$W/lto" 2>"$W/e"; then
	clean "$W/lto" && { r=$(run "$W/lto"); rc=$?; [ -z "$runner" ] && ok lto "links -static (not run)" || { [ "$rc" = 0 ] && ok lto "links+runs -static" || bad lto "ran rc=$rc"; }; } \
		|| bad lto "not static-clean"
else bad lto "$(head -1 "$W/e")"; fi

# --- lto-archive: gcc-ar LTO archive + plugin ---
"$GCC" -O2 -flto -c "$W/b.c" -o "$W/b.o" 2>/dev/null
if "$GCCAR" rcs "$W/libadd.a" "$W/b.o" 2>/dev/null && "$GCC" -O2 -flto "$W/a.c" -L"$W" -ladd -static -o "$W/ltoar" 2>"$W/e"; then
	ok lto-archive "gcc-ar LTO archive links -static"
else bad lto-archive "$(head -1 "$W/e")"; fi

# --- graphite: ISL-backed loop-nest optimizer is baked in ---
# isl is bundled solely for this. A gcc that silently lost its in-tree isl
# still passes every other gate here, while -floop-nest-optimize hard-errors
# for users ("isl is not available") — so probe the flags directly.
printf 'int main(void){volatile int s=0;int i,j;for(i=0;i<64;i++)for(j=0;j<64;j++)s+=i*j;return s>0?0:1;}\n' > "$W/gr.c"
if "$GCC" -O2 -fgraphite-identity -floop-nest-optimize -static "$W/gr.c" -o "$W/gr" 2>"$W/e"; then
	clean "$W/gr" && { r=$(run "$W/gr"); rc=$?; [ -z "$runner" ] && ok graphite "isl loop opts compile -static (not run)" || { [ "$rc" = 0 ] && ok graphite "isl loop opts compile+run -static" || bad graphite "ran rc=$rc"; }; } \
		|| bad graphite "not static-clean"
else bad graphite "$(head -1 "$W/e")"; fi

# --- zstd-debug: -gz=zstd compresses debug sections via our static libzstd ---
# gas only compresses when it shrinks the section, so feed it enough DWARF;
# assert the SHF_COMPRESSED flag AND a zstd frame magic (28 b5 2f fd) in both
# the .o (gas) and the linked binary (ld). A binutils built without zstd
# rejects the flag outright; a broken wiring falls back to zlib — both fail.
{
	printf '#include <stdio.h>\nstruct big{int a;char b[64];double c;};\n'
	i=1; while [ $i -le 40 ]; do printf 'int f%d(struct big*x){return x->a+%d;}\n' "$i" "$i"; i=$((i+1)); done
	printf 'int main(void){return 0;}\n'
} > "$W/zd.c"
zstd_dbg() { "$RE" -S "$1" 2>/dev/null | grep -m1 -A1 '\.debug_info' | grep -q ' C ' \
	&& od -A n -t x1 "$1" | tr -d ' \n' | grep -q 28b52ffd; }
if "$GCC" -O0 -g3 -gz=zstd -c "$W/zd.c" -o "$W/zd.o" 2>"$W/e" \
   && "$GCC" -O0 -g3 -gz=zstd -static "$W/zd.c" -o "$W/zdb" 2>>"$W/e"; then
	if zstd_dbg "$W/zd.o" && zstd_dbg "$W/zdb"; then
		ok zstd-debug "gas+ld emit SHF_COMPRESSED .debug_info with zstd frames"
	else
		bad zstd-debug "o=$(zstd_dbg "$W/zd.o" && echo y || echo n) bin=$(zstd_dbg "$W/zdb" && echo y || echo n) — not zstd-compressed"
	fi
else bad zstd-debug "$(head -1 "$W/e")"; fi

# --- zstd-lto: LTO bytecode is zstd-compressed (gcc --with-zstd wired in) ---
# a gcc built without zstd falls back to zlib silently; assert the zstd frame
# magic inside the LTO object's IL payload.
if "$GCC" -O2 -flto -c "$W/b.c" -o "$W/bz.o" 2>"$W/e"; then
	if od -A n -t x1 "$W/bz.o" | tr -d ' \n' | grep -q 28b52ffd; then
		ok zstd-lto "LTO IL sections carry zstd frames"
	else bad zstd-lto "no zstd frame in LTO object — zlib fallback (gcc built without zstd?)"; fi
else bad zstd-lto "$(head -1 "$W/e")"; fi

# --- openmp: libgomp links -static ---
printf '#include <stdio.h>\nint main(void){int n=0;\n#pragma omp parallel reduction(+:n)\nn+=1;\nreturn n>=1?0:1;}\n' > "$W/omp.c"
if "$GCC" -O2 -fopenmp -static "$W/omp.c" -o "$W/omp" 2>"$W/e"; then
	clean "$W/omp" && { r=$(run "$W/omp"); rc=$?; [ -z "$runner" ] && ok openmp "libgomp links -static (not run)" || { [ "$rc" = 0 ] && ok openmp "parallel reduction runs -static" || bad openmp "ran rc=$rc"; }; } \
		|| bad openmp "not static-clean"
else bad openmp "$(head -1 "$W/e")"; fi

# --- openmp-fortran: libgomp via the gfortran driver + omp_lib module ---
# separate driver/spec path from C, and `use omp_lib` proves the finclude
# module tree is installed and matches this gcc's module format.
if [ ! -x "$GFC" ]; then sk openmp-fortran "no gfortran driver"
else
	{
		printf 'program fo\n  use omp_lib\n  integer :: n\n  n = 0\n'
		printf '!$omp parallel reduction(+:n)\n  n = n + 1\n!$omp end parallel\n'
		printf '  if (n < 1 .or. n > omp_get_max_threads()) stop 1\nend program fo\n'
	} > "$W/fo.f90"
	if "$GFC" -O2 -fopenmp -static "$W/fo.f90" -o "$W/fo" 2>"$W/e"; then
		clean "$W/fo" && { r=$(run "$W/fo"); rc=$?; [ -z "$runner" ] && ok openmp-fortran "links -static (not run)" || { [ "$rc" = 0 ] && ok openmp-fortran "parallel region runs from gfortran" || bad openmp-fortran "ran rc=$rc"; }; } \
			|| bad openmp-fortran "not static-clean"
	else bad openmp-fortran "$(head -1 "$W/e")"; fi
fi

# --- libatomic: widest atomic that needs the lib (128-bit on 64-bit targets,
#     64-bit on 32-bit — __int128 doesn't exist there) ---
la=$("$GCC" -print-file-name=libatomic.a)
"$GCC" -dM -E -x c /dev/null 2>/dev/null | grep -q __SIZEOF_INT128__ && at='unsigned __int128' || at='unsigned long long'
printf '#include <stdatomic.h>\nint main(void){_Atomic %s a=0;atomic_fetch_add_explicit(&a,7,memory_order_seq_cst);return (int)a==7?0:1;}\n' "$at" > "$W/at.c"
if [ -f "$la" ] && "$GCC" -O2 -static "$W/at.c" -latomic -o "$W/at" 2>"$W/e"; then
	clean "$W/at" && { r=$(run "$W/at"); rc=$?; [ -z "$runner" ] && ok libatomic "$at atomics link -static (not run)" || { [ "$rc" = 0 ] && ok libatomic "$at atomics run -static" || bad libatomic "ran rc=$rc"; }; } \
		|| bad libatomic "not static-clean"
else bad libatomic "libatomic.a=$([ -f "$la" ] && echo y || echo n): $(head -1 "$W/e")"; fi

# --- quadmath: __float128 math links -static (libgfortran real(16) substrate) ---
if "$GCC" -dM -E -x c /dev/null 2>/dev/null | grep -q __SIZEOF_FLOAT128__; then
	printf '#include <quadmath.h>\nint main(void){__float128 x=sqrtq(2.0Q);double d=(double)(x*x);return (d>1.999&&d<2.001)?0:1;}\n' > "$W/qm.c"
	if "$GCC" -O2 -static "$W/qm.c" -lquadmath -o "$W/qm" 2>"$W/e"; then
		clean "$W/qm" && { r=$(run "$W/qm"); rc=$?; [ -z "$runner" ] && ok quadmath "links -static (not run)" || { [ "$rc" = 0 ] && ok quadmath "sqrtq round-trips -static" || bad quadmath "ran rc=$rc"; }; } \
			|| bad quadmath "not static-clean"
	else bad quadmath "$(head -1 "$W/e")"; fi
else sk quadmath "no __float128 on $target_arch"
fi

# --- ebcdic-iconv: bundled musl decodes EBCDIC codepages (IBM037 et al.) ---
# patches/musl-1.2.6/iconv-ebcdic-codepages.diff adds IBM037/500/1140/273.
# libxml2's xmlDetectEBCDIC hard-codes an IBM037 iconv handler to sniff any
# EBCDIC document (COBOL XML PARSE), and libgcobol's codepage layer resolves
# EBCDIC CODEPAGE names via iconv_open — both silently regress if a musl
# bump drops the patch. Charmap tables are runtime data, so the probe must
# run the binary; compile+link alone proves nothing.
cat > "$W/eb.c" <<'EOF'
#include <iconv.h>
#include <string.h>
static int conv(const char *to, const char *from,
                const char *in, size_t il, const char *want, size_t wl)
{
	char out[64], *ip = (char *)in, *op = out;
	size_t ol = sizeof out;
	iconv_t cd = iconv_open(to, from);
	if (cd == (iconv_t)-1) return 1;
	if (iconv(cd, &ip, &il, &op, &ol) == (size_t)-1 || il) return 1;
	iconv_close(cd);
	return (size_t)(op - out) != wl || memcmp(out, want, wl);
}
int main(void)
{
	/* "Zürich§": IBM037 -> UTF-8, and back */
	static const char e037[] = "\xe9\xdc\x99\x89\x83\x88\xb5";
	static const char u8[] = "\x5a\xc3\xbc\x72\x69\x63\x68\xc2\xa7";
	if (conv("UTF-8", "IBM037", e037, 7, u8, 9)) return 2;
	if (conv("IBM037", "UTF-8", u8, 9, e037, 7)) return 3;
	/* IBM500 via its Swiss IANA alias; IBM1140 euro at 0x9F; IBM273 */
	if (iconv_open("UTF-8", "ebcdic-cp-ch") == (iconv_t)-1) return 4;
	if (conv("UTF-8", "IBM1140", "\x9f", 1, "\xe2\x82\xac", 3)) return 5;
	if (iconv_open("UTF-8", "IBM273") == (iconv_t)-1) return 6;
	return 0;
}
EOF
if ! "$GCC" -O2 -static "$W/eb.c" -o "$W/eb" 2>"$W/e"; then bad ebcdic-iconv "$(head -1 "$W/e")"
elif ! clean "$W/eb"; then bad ebcdic-iconv "not static-clean"
elif [ -z "$runner" ]; then sk ebcdic-iconv "compile-only (charmap tables are runtime data)"
else
	r=$(run "$W/eb"); rc=$?
	[ "$rc" = 0 ] && ok ebcdic-iconv "IBM037 roundtrip; 500(ch)/1140-euro/273 present" \
		|| bad ebcdic-iconv "rc=$rc (2:037dec 3:037enc 4:500ch 5:1140euro 6:273)"
fi

# --- host-arch: compiler ELFs are for this machine, even when TARGET is foreign ---
# Catches host-cc using TARGET (aarch64-stage2 would ship an AArch64 cc1
# that cannot run on the x86_64 build host). Use the system readelf so a
# broken target-prefixed readelf trampoline cannot hide the mismatch.
case $host_arch in
	x86_64)  host_mach='X86-64' ;;
	aarch64) host_mach='AArch64' ;;
	arm*)    host_mach='ARM' ;;
	riscv64) host_mach='RISC-V' ;;
	i?86)    host_mach='80386' ;;
	*)       host_mach='' ;;
esac
host_re=$(command -v readelf || true)
[ -n "$host_re" ] || host_re=$RE
host_elfs=$GCC
[ -f "$GCC.real" ] && host_elfs=$GCC.real
cc1=$("$GCC" -print-prog-name=cc1 2>/dev/null || true)
[ -f "$cc1.real" ] && cc1=$cc1.real
[ -n "$cc1" ] && [ -f "$cc1" ] && host_elfs="$host_elfs $cc1"
ld=$("$GCC" -print-prog-name=ld 2>/dev/null || true)
[ -f "$ld.real" ] && ld=$ld.real
[ -n "$ld" ] && [ -f "$ld" ] && host_elfs="$host_elfs $ld"
if [ "$native" -eq 1 ] || [ -z "$host_mach" ]; then
	sk host-arch "native or unknown host arch"
else
	_ha=0
	for _f in $host_elfs; do
		"$host_re" -h "$_f" >/dev/null 2>&1 || continue
		"$host_re" -h "$_f" 2>/dev/null | grep -i 'Machine:' | grep -iq "$host_mach" || {
			_hm=$("$host_re" -h "$_f" 2>/dev/null | sed -n 's/^[[:space:]]*Machine:[[:space:]]*//p')
			bad host-arch "$(basename "$_f") is '$_hm' (host $host_arch want~$host_mach)"
			_ha=1
		}
	done
	[ "$_ha" -eq 0 ] && ok host-arch "gcc/cc1/ld are $host_mach (host $host_arch)"
fi

# --- host-musl: stage2 host tools must not NEEDED host glibc / extra .so ---
# stage1 is glibc-hosted by design (SKIP). After relocate, audit .real ELFs.
host_elf=$GCC
[ -f "$GCC.real" ] && host_elf=$GCC.real
if [ "$native" -eq 1 ]; then
	sk host-musl "native host gcc"
elif ! [ -f "$host_elf" ] || ! "$RE" -h "$host_elf" >/dev/null 2>&1; then
	sk host-musl "no ELF driver to audit"
else
	_hn=$("$RE" -d "$host_elf" 2>/dev/null | sed -n 's/.*(NEEDED)[^[]*\[\([^]]*\)\].*/\1/p')
	_bad=
	echo "$_hn" | grep -qx 'libc.so.6' && _bad="${_bad}libc.so.6 "
	echo "$_hn" | grep -qx 'libdebuginfod.so.1' && _bad="${_bad}libdebuginfod "
	echo "$_hn" | grep -qx 'libfl.so.2' && _bad="${_bad}libfl "
	# stage2 links the in-tree static libzstd.a (ZSTD_VER); the driver must not
	# pull the host's shared libzstd, so a glibc libzstd.so.1 NEEDED is a fail.
	echo "$_hn" | grep -qx 'libzstd.so.1' && _bad="${_bad}libzstd "
	if echo "$_hn" | grep -qx 'libc.so.6'; then
		sk host-musl "glibc-hosted stage1; stage2 preset for a portable prefix"
	elif [ -n "$_bad" ]; then
		bad host-musl "host NEEDED extra: $_bad"
	else
		ok host-musl "no host-glibc NEEDED ($(echo $_hn | tr '\n' ' '))"
	fi
fi

# --- host-as / host-ld: the tools gcc will exec must actually run ---
# $triple/bin/as is often a hard link of bin/$triple-as; a shared trampoline
# inode then looks for the wrong .real and every compile dies, while readelf
# of gcc.real still passes.
host_tool_runs() {
	_name=$1
	_p=$("$GCC" -print-prog-name="$1" 2>/dev/null || true)
	if [ -n "$_p" ] && [ -x "$_p" ] && "$_p" --version >/dev/null 2>"$W/e"; then
		ok "host-$_name" "$_name runs"
	else
		bad "host-$_name" "$(head -1 "$W/e" 2>/dev/null || echo "no $_name from $GCC")"
	fi
}
if [ "$native" -eq 1 ]; then
	sk host-as "native host gcc"
	sk host-ld "native host gcc"
else
	host_tool_runs as
	host_tool_runs ld
fi

# --- sanitizers (x86_64 only; Alpine enables libsanitizer there, off elsewhere) ---
# dev/CI instrumentation, NOT for -static production binaries. Verify the libs
# were built and the driver links them; not run here (dynamic asan needs the
# musl loader, absent on a cross host).
case $target_arch in
	x86_64|i?86)
		la=$("$GCC" -print-file-name=libasan.a); lu=$("$GCC" -print-file-name=libubsan.a)
		printf 'int main(void){return 0;}\n' > "$W/san.c"
		if [ -f "$la" ] && [ -f "$lu" ] && "$GCC" -O1 -fsanitize=address,undefined "$W/san.c" -o "$W/san" 2>"$W/e"; then
			ok sanitizers "libasan+libubsan built; -fsanitize=address,undefined links"
		else bad sanitizers "asan=$([ -f "$la" ] && echo y || echo n) ubsan=$([ -f "$lu" ] && echo y || echo n): $(head -1 "$W/e" 2>/dev/null)"; fi
		;;
	*) sk sanitizers "x86_64-only (Alpine parity); off on $target_arch" ;;
esac

# --- asan-runtime: the sanitizer must catch a real bug, not just link ---
# The asan binary is dynamic (NEEDED libasan.so + libc.so) and its PT_INTERP
# is /lib/ld-musl-*.so.1 — absent on a glibc build host. The prefix's own
# libc.so IS the loader (and is +x), so invoke it directly with --library-path.
if [ "$native" -eq 1 ]; then sk asan-runtime "native host gcc"
elif [ "$runner" != direct ]; then sk asan-runtime "needs native run (foreign/compile-only)"
else
	case $target_arch in
		x86_64|i?86)
			ldso="$toolchain/$triple/lib/libc.so"
			printf '#include <stdlib.h>\nint main(void){volatile int i=12;int*a=malloc(40);int v=a[i];free(a);return v;}\n' > "$W/ar.c"
			if [ -x "$ldso" ] && "$GCC" -O1 -fsanitize=address "$W/ar.c" -o "$W/ar" 2>"$W/e"; then
				"$ldso" --library-path "$toolchain/$triple/lib" "$W/ar" >/dev/null 2>"$W/ae"; rc=$?
				if [ "$rc" -ne 0 ] && grep -q 'AddressSanitizer: heap-buffer-overflow' "$W/ae"; then
					ok asan-runtime "heap-buffer-overflow detected at runtime (rc=$rc)"
				else bad asan-runtime "rc=$rc: $(head -1 "$W/ae" 2>/dev/null || echo 'no asan report')"; fi
			else bad asan-runtime "ldso=$([ -x "$ldso" ] && echo y || echo n): $(head -1 "$W/e" 2>/dev/null)"; fi
			;;
		*) sk asan-runtime "x86_64-only (matches sanitizers gate)" ;;
	esac
fi

# --- coverage: --coverage instruments, runs, and gcov reads the profile ---
# two-step compile so the notes file keeps the plain cov.gcno name (a combined
# compile+link mangles it to <output>-<src>.gcno, which gcov won't find).
printf 'int main(void){return 0;}\n' > "$W/cov.c"
if (cd "$W" && "$GCC" -O0 --coverage -c cov.c -o cov.o && "$GCC" --coverage -static cov.o -o cov) 2>"$W/e"; then
	if ! clean "$W/cov"; then bad coverage "not static-clean"
	elif [ -z "$runner" ]; then ok coverage "instrumented link -static (not run)"
	else
		r=$(run "$W/cov"); rc=$?
		if [ "$rc" = 0 ] && [ -f "$W/cov.gcda" ] && (cd "$W" && "$GCOV" cov.c 2>&1 | grep -q 'Lines executed'); then
			ok coverage "libgcov writes profile; gcov reads it"
		else bad coverage "rc=$rc gcda=$([ -f "$W/cov.gcda" ] && echo y || echo n)"; fi
	fi
else bad coverage "$(head -1 "$W/e")"; fi

# --- pgo: -fprofile-generate → run → -fprofile-use round-trip ---
# same -o both times: gcc keys the .gcda name to the output binary, so a
# changed name makes -fprofile-use silently find nothing. -Werror=missing-
# profile turns that silent miss into a FAIL.
printf 'volatile int x;int main(void){int i;for(i=0;i<1000;i++)x+=i;return 0;}\n' > "$W/pgo.c"
if [ -z "$runner" ]; then sk pgo "compile-only (profile must be generated by a run)"
elif (cd "$W" && "$GCC" -O2 -fprofile-generate -static pgo.c -o pgot) 2>"$W/e" \
     && r=$(run "$W/pgot") && [ -f "$W/pgot-pgo.gcda" ] \
     && (cd "$W" && "$GCC" -O2 -fprofile-use -Werror=missing-profile -static pgo.c -o pgot) 2>>"$W/e"; then
	ok pgo "generate → run → use round-trip"
else bad pgo "$(tail -1 "$W/e" 2>/dev/null)"; fi

# --- debug-paths: runtime-lib debug info must not leak the build tree ---
# --with-debug-prefix-map strips the repo root from libc.a/libgcc DWARF. A
# user's -g compile legitimately records *install prefix* include dirs, so
# only build/source-tree paths count as leaks. Only meaningful on the box
# that built the toolchain (elsewhere the paths differ → trivially clean).
if [ "$native" -eq 1 ]; then sk debug-paths "native host gcc"
else
	here=$(pwd)
	printf 'int main(void){return 0;}\n' > "$W/dp.c"
	if "$GCC" -O0 -g -static "$W/dp.c" -o "$W/dp" 2>"$W/e"; then
		leaks=$("$STRINGS" -a "$W/dp" 2>/dev/null | grep -F -e "$here/build/" -e "$here/musl-" -e "$here/gcc-" -e "$here/binutils-" | sort -u | head -3)
		[ -z "$leaks" ] && ok debug-paths "no build-tree paths in a -g static binary" \
			|| bad debug-paths "leaked: $(echo "$leaks" | tr '\n' ' ')"
	else bad debug-paths "$(head -1 "$W/e")"; fi
fi

echo "== $pass passed · $fail failed · $skip skipped =="
[ "$fail" -eq 0 ]
