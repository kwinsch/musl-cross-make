#!/bin/sh
# After `make install`, make a musl-dynamic stage2 prefix runnable off a
# glibc host and movable: ELF PT_INTERP cannot use $ORIGIN (the kernel
# loads it), so each host executable becomes a trampoline that execs the
# bundled musl loader. Shared objects (liblto_plugin.so) keep working via
# dlopen in that already-musl process.
#
# Usage: stage2/relocate OUTPUT TARGET [STAGE1]
# Host tools run on the bootstrap arch (STAGE1_TRIPLE), not TARGET.
set -eu

output=${1:?usage: stage2/relocate OUTPUT TARGET [STAGE1]}
target=${2:?}
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
stage1=${3:-${STAGE1:-"$root/output"}}
stage1_triple=${STAGE1_TRIPLE:-}
if [ -z "$stage1_triple" ] && [ -f "$root/config.mak" ]; then
	stage1_triple=$(awk -F= '/^[[:space:]]*STAGE1_TRIPLE[[:space:]]*=/{gsub(/[[:space:]]/,"",$2);print $2}' "$root/config.mak" | tail -n1)
fi
[ -n "$stage1_triple" ] || { echo "stage2/relocate: no STAGE1_TRIPLE (run ./configure <arch>-stage2)" >&2; exit 2; }

ldso_src="$stage1/$stage1_triple/lib/libc.so"
[ -f "$ldso_src" ] || { echo "stage2/relocate: no $ldso_src" >&2; exit 2; }
[ -d "$output/bin" ] || { echo "stage2/relocate: no $output/bin — make install first" >&2; exit 2; }
trap 'rm -f "$output/.relocate-list."$$' EXIT

# Loader name is the basename of musl's ldso symlink (ld-musl-<arch>.so.1).
# It points at /lib/libc.so and is dangling on a glibc host — [ -e ] follows
# the link and fails. [ -L ] is the name itself; [ -f ] covers a real file.
set -- "$stage1/$stage1_triple/lib"/ld-musl-*.so.1
[ -L "$1" ] || [ -f "$1" ] || { echo "stage2/relocate: no ld-musl-*.so.1 in $stage1/$stage1_triple/lib" >&2; exit 2; }
loader=$(basename "$1")

mkdir -p "$output/lib"
cp -a "$ldso_src" "$output/lib/libc.so"
chmod +x "$output/lib/libc.so"
ln -sfn libc.so "$output/lib/$loader"

# Idempotent trampoline. Walks up from the wrapped file to find lib/ld-musl-*.
# Resolve $0 through a last-hop symlink so a name in another directory
# (e.g. $triple/bin/as -> ../../bin/$triple-as) still finds THIS file's .real.
# Always write a new inode: `cat >dest` on a hard-linked dest would rewrite
# every name sharing that inode, and binutils hard-links bin/$triple-as to
# $triple/bin/as when TARGET matches the tool prefix.
write_trampoline() {
	_dest=$1
	_realbn=$(basename "$2")
	cat >"$_dest" <<EOF
#!/bin/sh
# stage2-trampoline
me=\$0
if [ -L "\$me" ]; then
	_link=\$(readlink -f "\$me" 2>/dev/null || readlink "\$me")
	case \$_link in
		/*) me=\$_link ;;
		*)  me=\$(CDPATH= cd -- "\$(dirname -- "\$me")" && printf '%s/%s\\n' "\$(pwd)" "\$_link") ;;
	esac
fi
here=\$(CDPATH= cd -- "\$(dirname -- "\$me")" && pwd)
real=\$here/$_realbn
d=\$here
while [ ! -x "\$d/lib/$loader" ] && [ "\$d" != / ]; do
	d=\$(dirname "\$d")
done
[ -x "\$d/lib/$loader" ] || { echo "\$0: no bundled musl loader above \$here" >&2; exit 127; }
exec "\$d/lib/$loader" --library-path "\$d/lib" "\$real" "\$@"
EOF
	chmod +x "$_dest"
}

is_elf() { readelf -h "$1" >/dev/null 2>&1; }
is_trampoline() { [ -f "$1" ] && grep -q '^# stage2-trampoline$' "$1" 2>/dev/null; }

# Drop stage1 absolute RPATH so the installed tree does not refer to it.
strip_rpath() {
	command -v patchelf >/dev/null 2>&1 || return 0
	patchelf --remove-rpath "$1" 2>/dev/null || true
}

has_interp() { readelf -l "$1" 2>/dev/null | grep -q 'INTERP'; }

# Wrap one regular file. Each path gets its own trampoline inode and a
# sibling <basename>.real — never cat> onto a hard-linked dest.
wrap_one() {
	f=$1
	case $f in
		*.real) return 0 ;;
		*.so|*.so.*) strip_rpath "$f"; return 0 ;;
		*.a|*.o|*.la|*.py) return 0 ;;
	esac
	real=$f.real
	if is_trampoline "$f"; then
		[ -f "$real" ] && is_elf "$real" || {
			echo "stage2/relocate: trampoline $f has no ELF $real" >&2
			exit 1
		}
	elif is_elf "$f"; then
		has_interp "$f" || { strip_rpath "$f"; return 0; }
		# Fresh copy so other hard links keep the ELF until their turn.
		cp -a "$f" "$real"
		strip_rpath "$real"
	else
		return 0
	fi
	# Unlink first: a new file, not an in-place truncate of a hard-link group.
	rm -f "$f"
	write_trampoline "$f" "$real"
}

# Host tools live in bin/, libexec/, and <triple>/bin/. Do not touch target
# runtime libs under <triple>/lib (those are for -static apps, not the driver).
# List-then-loop (no pipe) so set -e / exit in wrap_one abort the script.
wrap_dir() {
	[ -d "$1" ] || return 0
	# Regular files only — skip symlinks (cc -> gcc stays a symlink).
	_list=$output/.relocate-list.$$
	find "$1" -type f -print >"$_list"
	while IFS= read -r f; do
		wrap_one "$f"
	done <"$_list"
	rm -f "$_list"
}

wrap_dir "$output/bin"
wrap_dir "$output/libexec"
wrap_dir "$output/$target/bin"

# gcc finds as via $triple/bin/as (often a hard link of bin/$triple-as).
# If that trampoline looks for the wrong .real, every compile dies — fail now.
_as="$output/$target/bin/as"
if [ -x "$_as" ]; then
	"$_as" --version >/dev/null || {
		echo "stage2/relocate: $_as does not run after wrap" >&2
		exit 1
	}
fi

echo "stage2/relocate: wrapped host tools in $output (loader $output/lib/$loader)"
