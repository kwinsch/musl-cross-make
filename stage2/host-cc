#!/bin/sh
# Build stage2 host tools with the x86_64 musl stage1. The dynamic-linker path
# is /./-padded (see common.sh) so it runs on this machine during the build AND
# reserves a fixed PT_INTERP region for in-place rewriting at package time.
# No -rpath: the tools NEED only libc.so, which the musl loader (== the interp
# == libc) satisfies itself — nothing to scrub later. Triple is STAGE1_TRIPLE
# (the bootstrap), never TARGET (may be a foreign arch).
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
. "$root/stage2/common.sh"
mcm_stage1_env
cc="$stage1/bin/$stage1_triple-gcc"
ldso="$stage1/$stage1_triple/lib/libc.so"
[ -x "$cc" ] || { echo "stage2/host-cc: no $cc — install stage1 first (./configure x86_64 && make install)" >&2; exit 2; }
[ -f "$ldso" ] || { echo "stage2/host-cc: no musl loader at $ldso" >&2; exit 2; }
# Flags last so they win over a later -dynamic-linker from libtool/gcc.
exec "$cc" "$@" -Wl,-dynamic-linker="$(mcm_pad_interp "$ldso")"
