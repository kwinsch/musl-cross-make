#!/bin/sh
# Build stage2 host tools with the x86_64 musl stage1. Pin PT_INTERP / rpath
# to that sysroot so the result runs on this glibc machine. Triple is
# STAGE1_TRIPLE (the bootstrap), never TARGET (may be a foreign arch).
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
stage1=${STAGE1:-"$root/output"}
triple=${STAGE1_TRIPLE:-}
if [ -z "$triple" ] && [ -f "$root/config.mak" ]; then
	triple=$(awk -F= '/^[[:space:]]*STAGE1_TRIPLE[[:space:]]*=/{gsub(/[[:space:]]/,"",$2);print $2}' "$root/config.mak" | tail -n1)
fi
[ -n "$triple" ] || { echo "stage2/host-cc: no STAGE1_TRIPLE (run ./configure <arch>-stage2)" >&2; exit 2; }
cc="$stage1/bin/$triple-gcc"
ldso="$stage1/$triple/lib/libc.so"
lib="$stage1/$triple/lib"
[ -x "$cc" ] || { echo "stage2/host-cc: no $cc — install stage1 first (./configure x86_64 && make install)" >&2; exit 2; }
[ -f "$ldso" ] || { echo "stage2/host-cc: no musl loader at $ldso" >&2; exit 2; }
# Flags last so they win over a later -dynamic-linker from libtool/gcc.
exec "$cc" "$@" -Wl,-dynamic-linker="$ldso" -Wl,-rpath="$lib"
