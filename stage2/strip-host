#!/bin/sh
# stage2/strip-host OUTPUT TARGET
#
# Strip debug info + symbol tables from stage2 HOST tools (gcc, cc1, cc1plus,
# as, ld, ar, lto1, collect2, liblto_plugin.so, ...) before relocate wraps
# them. Host tools run on the build box, not the target, so their symbols are
# pure bloat in a distributed tree (a cross gcc drops ~8x: 20MB -> 2.5MB).
#
# Host tools live in bin/, libexec/, and <triple>/bin/ — the same dirs relocate
# walks. The target sysroot (<triple>/lib, <triple>/include, lib/gcc/<triple>)
# is left ALONE so users can still debug their own -static binaries built
# against this toolchain. Runs BEFORE relocate, i.e. over real ELF named
# gcc/as/... (no .real files exist yet). Idempotent.
set -eu

output=${1:?usage: stage2/strip-host OUTPUT TARGET}
target=${2:?}
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
stage1_triple=${STAGE1_TRIPLE:-}
if [ -z "$stage1_triple" ] && [ -f "$root/config.mak" ]; then
	stage1_triple=$(awk -F= '/^[[:space:]]*STAGE1_TRIPLE[[:space:]]*=/{gsub(/[[:space:]]/,"",$2);print $2}' "$root/config.mak" | tail -n1)
fi

# Prefer the stage1 toolchain's strip (arch-matched to the x86_64 host tools);
# fall back to the system strip. Both handle x86_64 ELF. The stage1 tree in
# output/ is NOT relocated, so its strip is a plain runnable ELF.
strip=strip
if [ -n "$stage1_triple" ] && [ -x "$root/output/bin/$stage1_triple-strip" ]; then
	strip="$root/output/bin/$stage1_triple-strip"
fi

[ -d "$output/bin" ] || { echo "stage2/strip-host: no $output/bin — make install first" >&2; exit 2; }

is_elf() { readelf -h "$1" >/dev/null 2>&1; }

# List-then-loop (no pipe) so a strip failure under set -e aborts the script.
strip_dir() {
	[ -d "$1" ] || return 0
	_list=$output/.strip-list.$$
	# Regular files only — skip symlinks (cc -> gcc, ld -> ld.bfd).
	find "$1" -type f -print >"$_list"
	while IFS= read -r f; do
		case $f in
			*.a|*.o|*.la|*.py|*.h|*.pc|*.mk) continue ;;
		esac
		is_elf "$f" || continue
		# Plain strip: removes .debug/.symtab, keeps .dynsym so liblto_plugin.so
		# and libcc1.so stay loadable. Safe on both executables and .so.
		"$strip" "$f"
	done <"$_list"
	rm -f "$_list"
}

strip_dir "$output/bin"
strip_dir "$output/libexec"
strip_dir "$output/$target/bin"

echo "stage2/strip-host: stripped host tools in $output (strip: $strip)"
