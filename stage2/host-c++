#!/bin/sh
# Same as host-cc for C++ host tools. -static-libstdc++ so cc1plus etc. only
# NEED musl libc — no extra .so to ship in the portable prefix.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
. "$root/stage2/common.sh"
mcm_stage1_env
cxx="$stage1/bin/$stage1_triple-g++"
ldso="$stage1/$stage1_triple/lib/libc.so"
[ -x "$cxx" ] || { echo "stage2/host-c++: no $cxx — install stage1 first (./configure x86_64 && make install)" >&2; exit 2; }
[ -f "$ldso" ] || { echo "stage2/host-c++: no musl loader at $ldso" >&2; exit 2; }
exec "$cxx" -static-libstdc++ -static-libgcc "$@" -Wl,-dynamic-linker="$(mcm_pad_interp "$ldso")"
