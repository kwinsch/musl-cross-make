#!/bin/sh
# configure — select a toolchain preset and generate config.mak.
#
# Presets live in presets/. A curated (selectable) preset carries a "# name:"
# header and may declare "# inherits: <preset>" to pull in a shared base. This
# script resolves the inheritance chain and writes a flat, self-contained
# config.mak (local-only; gitignored). Component versions come from the
# top-level Makefile defaults, not from presets.
#
# Usage:
#   ./configure                interactive menu
#   ./configure <preset>       select directly, e.g. ./configure x86_64
#   ./configure -l | --list    list curated presets
#   ./configure -h | --help    this help

set -eu

cd "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
PRESETS=presets
CONFIG=config.mak
TAB=$(printf '\t')

die()   { printf 'configure: %s\n' "$*" >&2; exit 1; }
usage() { sed -n '3,15p' "$0" | sed 's/^#\{0,1\} \{0,1\}//'; }

# Read a "# <field>: value" header from a preset file.
hdr() { sed -n "s/^# $1:[[:space:]]*//p" "$2" | head -n1; }

# Ordered inheritance chain for a preset (base-most first), as file paths.
resolve() {
	f=$PRESETS/$1
	[ -f "$f" ] || die "no such preset: $1"
	parent=$(hdr inherits "$f")
	if [ -n "$parent" ]; then resolve "$parent"; fi
	printf '%s\n' "$PRESETS/$1"
}

# Flatten a preset (+ inherited bases) into a self-contained config.mak.
generate() {
	preset=$1
	[ -f "$PRESETS/$preset" ] || die "no such preset: $preset"
	{
		printf '# config.mak — generated by ./configure; do not hand-maintain.\n'
		printf '# preset: %s   (edit presets/ then re-run ./configure)\n' "$preset"
		printf '# local & gitignored; append overrides at the very end if unavoidable.\n\n'
		for f in $(resolve "$preset"); do
			printf '# --- %s ---\n' "$f"
			grep -vE '^# (name|desc|inherits):' "$f"
			printf '\n'
		done
	} >"$CONFIG"
	target=$(sed -n 's/^TARGET[[:space:]]*=[[:space:]]*//p' "$CONFIG" | head -n1)
	printf 'wrote %s  (preset: %s, target: %s)\n' "$CONFIG" "$preset" "${target:-UNSET}"
	printf '  next: make && make install\n'
}

# List selectable presets as "id<TAB>name<TAB>desc".
list_curated() {
	for f in "$PRESETS"/*; do
		[ -f "$f" ] || continue
		[ -n "$(hdr name "$f")" ] || continue
		printf '%s%s%s%s%s\n' "${f#"$PRESETS"/}" "$TAB" "$(hdr name "$f")" "$TAB" "$(hdr desc "$f")"
	done
}

if [ $# -ge 1 ]; then
	case $1 in
		-h|--help) usage; exit 0 ;;
		-l|--list) list_curated | while IFS=$TAB read -r id nm ds; do printf '  %-10s %s\n' "$id" "$ds"; done; exit 0 ;;
		-*) die "unknown option: $1 (try --help)" ;;
		*) generate "$1"; exit 0 ;;
	esac
fi

curated=$(list_curated)
[ -n "$curated" ] || die "no curated presets found in $PRESETS/"

if command -v fzf >/dev/null 2>&1 && [ -z "${MCM_NO_FZF:-}" ]; then
	sel=$(printf '%s\n' "$curated" | fzf --delimiter="$TAB" --with-nth=2,3 \
		--prompt='preset> ' --height=40% --reverse) || die "cancelled"
	generate "$(printf '%s' "$sel" | cut -f1)"
	exit 0
fi

printf 'musl-cross-make · select a toolchain preset:\n\n'
n=0
printf '%s\n' "$curated" | while IFS=$TAB read -r id nm ds; do
	n=$((n+1)); printf '  %d) %-24s %s\n' "$n" "$nm" "$ds"
done
ids=$(printf '%s\n' "$curated" | cut -f1)
count=$(printf '%s\n' "$ids" | grep -c .)
printf '\n> '
read -r n
case $n in ''|*[!0-9]*) die "invalid selection" ;; esac
{ [ "$n" -ge 1 ] && [ "$n" -le "$count" ]; } || die "selection out of range"
generate "$(printf '%s\n' "$ids" | sed -n "${n}p")"
