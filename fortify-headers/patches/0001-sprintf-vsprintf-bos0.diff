stdio.h: size sprintf/vsprintf by the maximum object size, trap on 0 remaining

sprintf and vsprintf used __bos(s, 2) -- the MINIMUM object size -- and
treated 0 as "unknown". Two consequences, both verified with gcc 16.2 /
musl 1.2.6 at -O2:

 1. False positive at _FORTIFY_SOURCE=2: with a pointer that may refer to
    one of several objects, the minimum is used, so
        static char a[4], b[64];
        sprintf(cond ? b : a, "%s", "0123456789");   /* cond true */
    traps although the write fits b. (glibc and level 3 do not trap.)

 2. Missed overflow at exactly 0 bytes remaining: __bos() == 0 fell through
    to the unchecked sprintf, so
        static char buf[8]; sprintf(buf + 8, "%s", "xx");
        char *p = malloc(8); sprintf(p + 8, "%s", "xx");      /* level 3 */
    wrote past the object unchecked (glibc aborts on both).

Use __bos(s, 0) like every other wrapper in this file and only skip the
check when the size is genuinely unknown ((size_t)-1). A 0-byte object now
goes through snprintf(s, 0, ...) and traps for any output (even "" needs the
terminating NUL).

Local fix on top of fortify-headers 3.0.2 (musl-cross-make); to be offered
upstream (github.com/jvoisin/fortify-headers).

--- a/include/stdio.h
+++ b/include/stdio.h
@@ -95,10 +95,10 @@
 _FORTIFY_FN(vsprintf) int vsprintf(char * _FORTIFY_POS0 __s, const char *__f,
                                    __builtin_va_list __v)
 {
-	size_t __b = __bos(__s, 2);
+	size_t __b = __bos(__s, 0);
 	int __r;
 
-	if (__b) {
+	if (__b != (size_t)-1) {
 		__r = __orig_vsnprintf(__s, __b, __f, __v);
 		if (__r != -1 && (size_t)__r >= __b)
 			__builtin_trap();
@@ -136,10 +136,10 @@
 __fortify__format(printf, 2, 3)
 _FORTIFY_FN(sprintf) int sprintf(char *__s, const char *__f, ...)
 {
-	size_t __b = __bos(__s, 2);
+	size_t __b = __bos(__s, 0);
 	int __r;
 
-	if (__b) {
+	if (__b != (size_t)-1) {
 		__r = __orig_snprintf(__s, __b, __f, __builtin_va_arg_pack());
 		if (__r != -1 && (size_t)__r >= __b)
 			__builtin_trap();
